# Dockerfile.worker — media worker image (opus codec => CGO).
# Build:  docker build -f deploy/Dockerfile.worker -t voicebridge-worker .
FROM golang:1.22-alpine AS build
WORKDIR /src

RUN apk add --no-cache git ca-certificates build-base opus-dev
COPY go.mod go.sum* ./
RUN go mod download || true

COPY . .
RUN CGO_ENABLED=1 go build -trimpath -o /out/worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates opus
COPY --from=build /out/worker /usr/local/bin/worker

USER nobody
ENTRYPOINT ["/usr/local/bin/worker"]
