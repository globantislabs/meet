# Dockerfile.api — control-plane HTTP API image.
# Build:  docker build -f deploy/Dockerfile.api -t voicebridge-api .
FROM golang:1.22-alpine AS build
WORKDIR /src

# Dependencies first (cached layer). CGO is required by the opus codec.
RUN apk add --no-cache git ca-certificates build-base opus-dev
COPY go.mod go.sum* ./
RUN go mod download || true

COPY . .
RUN CGO_ENABLED=1 go build -trimpath -o /out/api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates opus
COPY --from=build /out/api /usr/local/bin/api
COPY migrations /app/migrations

EXPOSE 8080
USER nobody
ENTRYPOINT ["/usr/local/bin/api"]
